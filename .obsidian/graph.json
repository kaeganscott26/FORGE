{
  "collapse-filter": true,
  "search": "-path:node_modules -path:dist -path:dist_electron -path:apps/desktop/out -path:.forge",
  "showTags": true,
  "showAttachments": false,
  "hideUnresolved": true,
  "showOrphans": false,
  "collapse-color-groups": false,
  "colorGroups": [
    {
      "query": "path:docs",
      "color": {
        "a": 1,
        "rgb": 10485760
      }
    },
    {
      "query": "path:apps",
      "color": {
        "a": 1,
        "rgb": 5635925
      }
    },
    {
      "query": "path:packages",
      "color": {
        "a": 1,
        "rgb": 4437377
      }
    }
  ],
  "collapse-display": true,
  "showArrow": true,
  "textFadeMultiplier": 0,
  "nodeSizeMultiplier": 1.1,
  "lineSizeMultiplier": 1.1,
  "collapse-forces": true,
  "centerStrength": 0.6,
  "repelStrength": 12,
  "linkStrength": 1,
  "linkDistance": 220,
  "scale": 0.7,
  "close": true
}
