{
  "name": "forge",
  "version": "1.0.1",
  "private": true,
  "description": "Local-first AI-native development workspace",
  "author": "Kaegan Scott",
  "homepage": "https://github.com/kaeganscott26/FORGE",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaeganscott26/FORGE.git"
  },
  "type": "module",
  "main": "apps/desktop/out/main/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev apps/desktop",
    "start-renderer": "vite apps/desktop/src/renderer",
    "build": "npm run typecheck && electron-vite build apps/desktop",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:mac:universal": "npm run build && electron-builder --mac --universal --publish never",
    "install:mac": "bash scripts/install-mac.sh",
    "release:mac": "npm run build && electron-builder --mac --universal --publish always",
    "preview": "electron-vite preview apps/desktop",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "clean": "rimraf apps/desktop/out apps/desktop/dist coverage dist_electron"
  },
  "build": {
    "appId": "com.kaeganscott26.forge",
    "productName": "FORGE",
    "icon": "apps/desktop/resources/ForgeIcon-1024.png",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "apps/desktop/out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "kaeganscott26",
        "repo": "FORGE",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "eslint": "^9.17.0",
    "globals": "^15.15.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "marked": "^15.0.0",
    "monaco-editor": "0.53.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-git": "^3.27.0",
    "sql.js": "^1.12.0",
    "zustand": "^5.0.0"
  },
  "allowScripts": {
    "electron@43.3.0": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
