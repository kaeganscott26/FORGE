{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI-native development workspace",
  "type": "module",
  "main": "apps/desktop/out/main/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev apps/desktop",
    "start-renderer": "vite apps/desktop/src/renderer",
    "build": "npm run typecheck && electron-vite build apps/desktop",
    "package:mac": "npm run build && electron-builder --mac",
    "open:mac": "open dist_electron/mac-arm64/Forge.app",
    "package:mac-open": "npm run package:mac && npm run open:mac",
    "preview": "electron-vite preview apps/desktop",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "clean": "rimraf apps/desktop/out apps/desktop/dist coverage dist_electron"
  },
  "build": {
    "appId": "com.forge.desktop",
    "productName": "Forge",
    "icon": "apps/desktop/resources/Forge.icns",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "apps/desktop/out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": false,
    "publish": [
      {
        "provider": "github",
        "owner": "YOUR_GITHUB_USER",
        "repo": "YOUR_REPO",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "identity": "Developer ID Application: YOUR NAME (TEAMID)",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.3.0",
    "electron-vite": "^3.1.0",
    "eslint": "^9.17.0",
    "electron-builder": "^24.4.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-git": "^3.27.0",
    "sql.js": "^1.12.0",
    "zustand": "^5.0.0"
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
