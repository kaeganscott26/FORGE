{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI-native development workspace",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev apps/desktop",
    "build": "npm run typecheck && electron-vite build apps/desktop",
    "preview": "electron-vite preview apps/desktop",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "clean": "rimraf apps/desktop/out apps/desktop/dist coverage"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-vite": "^3.1.0",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-git": "^3.27.0",
    "sql.js": "^1.12.0",
    "zustand": "^5.0.0"
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
