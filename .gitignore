cat > .gitignore <<'EOF'
# Dependencies
node_modules/

# Build output
dist/
dist_electron/
out/
apps/desktop/out/
apps/desktop/dist/
.vite/
coverage/
release/

# Electron Builder
*.dmg
*.pkg
*.zip
*.blockmap
builder-debug.yml
builder-effective-config.yaml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local FORGE data
.forge/

# Environment
.env
.env.local
.env.*
!.env.example

# TypeScript
*.tsbuildinfo

# macOS
.DS_Store

# Obsidian machine-local state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
EOF